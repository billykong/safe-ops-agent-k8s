{
 "uid": "safe-ops-agent",
 "title": "Safe-ops agent: cost, escalation, quality, oversight, audit, traces",
 "tags": [
  "safe-ops",
  "p4"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "editable": false,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "description": "P4 milestone 1: tokens, estimated cost and escalation rate from the gateways, the approval controller and the agent; traces from Jaeger. P4 milestone 2: the API audit log's counters and the sink's chain. P4 milestone 5: quality next to throughput (eval results, reopen rate) and oversight health, from records the agent can't write.",
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Cost and escalation (over the selected time range)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Agent tasks",
   "description": "Decisions the agent made (agent-reported: safeops_agent_tasks_total).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(safeops_agent_tasks_total[$__range]))",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
