# How the API server reaches the audit sink (its webhook backend). The API
# server runs on the node's network and resolves names with the node's
# resolver, not cluster DNS, so the sink's Service has a fixed ClusterIP
# (Cilium translates it in the node's network namespace). The certificate
# files are written by scripts/audit-setup.sh.
apiVersion: v1
kind: Config
clusters:
- name: audit-sink
  cluster:
    server: https://10.96.0.200:8443/audit
    certificate-authority: /etc/kubernetes/audit/ca.crt
users:
- name: kube-apiserver
  user:
    client-certificate: /etc/kubernetes/audit/client.crt
    client-key: /etc/kubernetes/audit/client.key
contexts:
- name: default
  context: {cluster: audit-sink, user: kube-apiserver}
current-context: default
